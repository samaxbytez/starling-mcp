# Live account
STARLING_ACCESS_TOKEN=your_personal_access_token_here

# Sandbox (uses its own token; never falls back to the live one)
# STARLING_ENV=sandbox
# STARLING_SANDBOX_ACCESS_TOKEN=your_sandbox_token_here

# Registers the tools that move money. Off by default.
# STARLING_ENABLE_SENSITIVE_TOOLS=true
